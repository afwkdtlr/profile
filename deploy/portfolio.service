[Unit]
Description=Portfolio API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/profile/backend
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:+UseSerialGC -jar /opt/profile/backend/portfolio.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
